# Cross-compilation: build stage runs on the host platform to avoid QEMU
# segfaults with aws-lc-sys on kernels > 6.8.0-49 (docker/buildx#3170).

ARG BUILDPLATFORM

FROM --platform=$BUILDPLATFORM rust:1.92-bookworm AS builder
ARG TARGETARCH

RUN apt-get update && \
    apt-get install -y g++-aarch64-linux-gnu libc6-dev-arm64-cross && \
    rm -rf /var/lib/apt/lists/*
RUN rustup target add aarch64-unknown-linux-gnu

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar

WORKDIR /build
COPY . .

ARG FEATURES=""
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      cargo build --release -p mina-frost-client \
        --target aarch64-unknown-linux-gnu \
        ${FEATURES:+--features $FEATURES} && \
      mkdir -p target/release && \
      cp target/aarch64-unknown-linux-gnu/release/mina-frost-client target/release/mina-frost-client; \
    else \
      cargo build --release -p mina-frost-client ${FEATURES:+--features $FEATURES}; \
    fi

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/mina-frost-client /usr/local/bin/mina-frost-client

ENTRYPOINT ["/usr/local/bin/mina-frost-client"]
