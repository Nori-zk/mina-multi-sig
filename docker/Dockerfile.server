# Cross-compilation: all build stages run on the host platform (FROM --platform=$BUILDPLATFORM)
# and cross-compile to the target arch. This avoids QEMU emulation during compilation, which
# segfaults with aws-lc-sys on kernels > 6.8.0-49 (docker/buildx#3170).

ARG BUILDPLATFORM
ARG TARGETARCH

# Stage 1: build frostd
FROM --platform=$BUILDPLATFORM rust:1.92-bookworm AS frostd-builder
ARG TARGETARCH

RUN apt-get update && \
    apt-get install -y g++-aarch64-linux-gnu libc6-dev-arm64-cross && \
    rm -rf /var/lib/apt/lists/*
RUN rustup target add aarch64-unknown-linux-gnu

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar

ARG FROSTD_COMMITISH
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      cargo install \
        --git https://github.com/ZcashFoundation/frost-tools.git \
        --rev ${FROSTD_COMMITISH} \
        --locked \
        --target aarch64-unknown-linux-gnu \
        frostd; \
    else \
      cargo install \
        --git https://github.com/ZcashFoundation/frost-tools.git \
        --rev ${FROSTD_COMMITISH} \
        --locked \
        frostd; \
    fi

# Stage 2: build frost-supervisor (temporary PID 1 workaround — see frost-supervisor/README.md)
FROM --platform=$BUILDPLATFORM rust:1.92-bookworm AS supervisor-builder
ARG TARGETARCH

RUN apt-get update && \
    apt-get install -y g++-aarch64-linux-gnu libc6-dev-arm64-cross && \
    rm -rf /var/lib/apt/lists/*
RUN rustup target add aarch64-unknown-linux-gnu

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar

WORKDIR /build
COPY docker/frost-supervisor/ .
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      cargo build --release --target aarch64-unknown-linux-gnu && \
      mkdir -p target/release && \
      cp target/aarch64-unknown-linux-gnu/release/frost-supervisor target/release/frost-supervisor; \
    else \
      cargo build --release; \
    fi

# Stage 3: collect nginx binary and its non-glibc dynamic dependencies.
# Uses nginx:bookworm (glibc-linked) to match distroless/cc-debian12.
# patchelf embeds the rpath so the final image can find the bundled libs.
FROM nginx:bookworm AS nginx-source
RUN apt-get update && apt-get install -y patchelf && rm -rf /var/lib/apt/lists/*
RUN set -e; \
    mkdir -p /nginx-libs; \
    ldd /usr/sbin/nginx \
      | awk '/=>/ { print $3 }' \
      | grep -Ev '(libm\.so|libc\.so|libdl\.so|libpthread\.so|librt\.so|libgcc_s\.so|libresolv\.so|ld-linux)' \
      | grep -v '^$' \
      | xargs -I{} cp -n {} /nginx-libs/; \
    patchelf --set-rpath /usr/local/nginx-libs /usr/sbin/nginx

# Stage 4: minimal distroless runtime
FROM gcr.io/distroless/cc-debian12
ARG TARGETARCH

COPY --from=frostd-builder     /usr/local/cargo/bin/frostd                         /usr/local/bin/frostd
COPY --from=nginx-source       /usr/sbin/nginx                                      /usr/sbin/nginx
COPY --from=nginx-source       /nginx-libs/                                         /usr/local/nginx-libs/
COPY                           docker/nginx.conf                                     /etc/nginx/nginx.conf

COPY --from=supervisor-builder /build/target/release/frost-supervisor               /usr/local/bin/frost-supervisor

EXPOSE 2744

ENTRYPOINT ["/usr/local/bin/frost-supervisor"]
